{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hamilton-furniture",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hamilton-furniture-db",
      "database_id": "db1649c3-a090-4035-984f-ecb1cec4ea43",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "hamilton-furniture-images"
    }
  ],
  "vars": {
    "STORE_NAME": "Hamilton's Odds N Ends Furniture",
    "PUBLIC_SITE_URL": "https://hamiltonsoddsandends.com",
    "SQUARE_ENVIRONMENT": "sandbox",
    "SQUARE_APPLICATION_ID": "sandbox-sq0idb-gYR4l6Xn2glvJzYHY4PiTQ",
    "SQUARE_LOCATION_ID": "LW1KFRCAM2WQZ"
  },
  "routes": [
    {
      "pattern": "hamiltonsoddsandends.com",
      "custom_domain": true
    },
    {
      "pattern": "www.hamiltonsoddsandends.com",
      "custom_domain": true
    }
  ]
}
